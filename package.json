{
  "name": "@local/prompt-polish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Composer prompt-polish button: rewrites the draft prompt with the session's own model and context, then offers undo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nolodjska/dsh-prompt-polish.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./optimize": "./optimize.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "optimize.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
